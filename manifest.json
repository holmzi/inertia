{
    "manifest_version": 3,
    "name": "Inertia",
    "version": "1.0.0",
    "description": "Smooth scrolling for Chrome and Chromium-based browsers.",
    "minimum_chrome_version": "119",
    "permissions": ["storage"],
    "icons": { "128": "res/icons/128.png" },
    "action": {
        "default_title": "Inertia",
        "default_popup": "src/popup/index.html"
    },
    "content_scripts": [
        {
            "matches": ["http://*/*", "https://*/*", "file:///*"],
            "js": [
                "src/settings.js",
                "src/scroll/target.js",
                "src/scroll/animation.js",
                "src/scroll/wheel.js",
                "src/content.js"
            ],
            "match_origin_as_fallback": true,
            "all_frames": true,
            "run_at": "document_start"
        }
    ]
}
